  "item": [
    {
      "name": "POST - Falta headers de trazabilidad (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "consumerId",
            "value": "{{consumerId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellidoPaterno\": \"Perez\",\n  \"apellidoMaterno\": \"Lopez\",\n  \"activo\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Nombre vacío (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "consumerId",
            "value": "{{consumerId}}"
          },
          {
            "key": "traceparent",
            "value": "{{traceparent}}"
          },
          {
            "key": "deviceType",
            "value": "{{deviceType}}"
          },
          {
            "key": "deviceId",
            "value": "{{deviceId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"apellidoPaterno\": \"Perez\",\n  \"apellidoMaterno\": \"Lopez\",\n  \"activo\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "const body = pm.response.json();",
              "pm.test(\"Retorna código de validación\", function () {",
              "  pm.expect(body.code).to.eql(\"4000\");",
              "});"
            ]
          }
        }
      ]
    },
